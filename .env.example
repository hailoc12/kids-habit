# Kids Habit — cấu hình tùy chọn
# Không có file này app vẫn chạy đầy đủ tính năng chính.
# Camera / Home Automation / Tranh tô màu AI cần cấu hình thêm.

# ── Bảo mật (ĐỔI khi deploy thật) ──────────────────────────────
# PIN vào khu bố mẹ (/parent)
PARENT_PIN=1310
# Salt băm mật khẩu — dùng chuỗi ngẫu nhiên dài, đổi một lần duy nhất
KH_AUTH_SALT=change-me-to-a-long-random-string

# ── Camera nhà (RTSP → HLS, chạy trên máy chủ trong LAN) ──────
# Bắt buộc đủ 3 biến nếu bật tính năng camera
KH_CAMERA_USER=
KH_CAMERA_PASS=
KH_CAMERA_IP=
# Override toàn bộ URL RTSP (bỏ qua 3 biến trên) — lens 1 / lens 2
# KH_RTSP_URL=rtsp://user:pass@ip/live/ch00_0
# KH_RTSP_URL_2=rtsp://user:pass@ip/live/ch01_0
# Đường dẫn ffmpeg trên máy chủ (mặc định: tự tìm trong PATH)
# KH_FFMPEG=/opt/homebrew/bin/ffmpeg

# ── Home Automation (Apple TV / soundbar qua pyatv) ────────────
# KH_APPLETV_IP=
# KH_SOUNDBAR_IP=
# KH_ATVREMOTE=atvremote

# ── Tranh tô màu AI (Gemini web qua script gen-image.js) ───────
# Đường dẫn tuyệt đối đến gen-image.js trên máy chủ
# KH_GEN_IMAGE_JS=/path/to/gen-image.js
# KH_NODE_BIN=node

# ── Hạ tầng ─────────────────────────────────────────────────────
# Đường dẫn ffmpeg chạy lệnh ssh (mặc định 127.0.0.1 — máy chủ local)
# KH_SSH_TARGET=127.0.0.1
# Thư mục data (mặc định ./data)
# KH_DATA_DIR=
# Thư mục sách epub (mặc định ./books)
# KH_BOOKS_DIR=

# ── Deploy ──────────────────────────────────────────────────────
# Máy chủ đích của scripts/deploy.sh
# KH_DEPLOY_HOST=your-mac-mini.local
